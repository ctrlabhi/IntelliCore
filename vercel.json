{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "buildCommand": "npm run build",
  "functions": {
    "app.js": {
      "maxDuration": 60,
      "includeFiles": "{frontend/**,backend/src/**,node_modules/.prisma/client/**,prisma/schema.prisma}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/internal/notification-tick",
      "schedule": "0 0 * * *"
    }
  ]
}
