# ==============================================================================
# INTELLICORE V2.0 — VERCEL & HOSTINGER PRODUCTION CONFIGURATION (.env.production.example)
# ==============================================================================
# This blueprint contains the exact environment variables required in Vercel Project Settings.
# Enter these in: Vercel Dashboard -> Your Project -> Settings -> Environment Variables.
# NEVER commit production secrets or real database credentials to Git!
# ==============================================================================

# 1. Application Settings
NODE_ENV=production
APP_BASE_URL=https://www.intellicoretechnologies.in
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# 2. Hostinger Remote Database Connection
# You can enter individual variables (beginner-friendly):
DB_HOST=sql123.main-hosting.eu
DB_PORT=3306
DB_NAME=u123456789_intellicore
DB_USER=u123456789_app
DB_PASSWORD=your_secure_remote_db_password
DB_SSL=true

# Or provide the full connection URL directly:
# DATABASE_URL=mysql://u123456789_app:your_password@sql123.main-hosting.eu:3306/u123456789_intellicore?sslaccept=strict&connection_limit=2&connect_timeout=5&pool_timeout=5

# 3. Dedicated Background Worker Database Account (Optional on single-user plans)
# NOTIFICATION_DATABASE_URL=mysql://u123456789_worker:worker_password@sql123.main-hosting.eu:3306/u123456789_intellicore?sslaccept=strict

# 4. Firebase Production Authentication (Web Client)
FIREBASE_PROJECT_ID=intellicore-229
FIREBASE_API_KEY=your_production_web_api_key
FIREBASE_AUTH_DOMAIN=intellicore-229.firebaseapp.com
FIREBASE_STORAGE_BUCKET=intellicore-229.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_production_sender_id
FIREBASE_APP_ID=your_production_app_id

# 5. Firebase Admin SDK Credentials (Serverless Vercel Functions)
# Copy these from your downloaded Service Account JSON:
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@intellicore-229.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 6. Persistent File Storage (Vercel Blob)
# Create a Vercel Blob store under Storage tab in Vercel Dashboard and attach it to your project.
STORAGE_PROVIDER=vercel-blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# 7. Scheduled Background Processing (Vercel Cron)
# Generate a cryptographically random 32-64 character string:
CRON_SECRET=minimum_32_character_random_hex_secret_here
NOTIFICATION_CRON_ENABLED=true

# 8. Transactional Email Delivery Mode
# Keep CAPTURE until external SMTP mailbox and domain authentication are fully approved:
EMAIL_DELIVERY_MODE=CAPTURE
EMAIL_SMTP_AUTHORIZED=false

# 9. Security & CORS
CORS_ORIGIN=https://www.intellicoretechnologies.in
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# 10. Founder Production Identity (Initial Setup)
FOUNDER_EMAIL=founder@intellicoretechnologies.in
FOUNDER_FIREBASE_UID=your_production_firebase_uid
