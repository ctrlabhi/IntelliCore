# ==============================================================================
# IntelliCore Environment Configuration Blueprint (Phase 1 Foundation)
# Copy this file to .env and configure local credentials.
# NEVER commit real credentials to version control.
# ==============================================================================

# Core Application Settings
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# File Storage Configuration
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_SIZE_MB=25
TASK_MAX_FILE_SIZE_MB=5
TASK_MAX_ATTACHMENTS=5

# MySQL 8.4 LTS Database Configuration
MYSQL_DATABASE=intellicore_db
MYSQL_USER=intellicore_app
MYSQL_PASSWORD=replace_with_strong_password_in_env
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password_in_env

# Prisma Database Connection URL
# Note: Ensure password characters are URL-encoded if special characters are used.
# Internal Docker network connection:
DATABASE_URL=mysql://intellicore_app:replace_with_strong_password_in_env@mysql:3306/intellicore_db?connection_limit=10&connect_timeout=15

# Local Host fallback URL (when running tests or scripts directly against host-mapped port):
# DATABASE_URL=mysql://intellicore_app:replace_with_strong_password_in_env@127.0.0.1:3306/intellicore_db?connection_limit=10&connect_timeout=15

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000

# ==============================================================================
# Firebase Development Authentication Configuration (Phase 2A)
# ==============================================================================

# Project & Admin SDK Service Account
FIREBASE_PROJECT_ID=intellicore-dev
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin-dev.json

# Public Firebase Web Client Configuration (Development)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=intellicore-dev.firebaseapp.com
FIREBASE_STORAGE_BUCKET=intellicore-dev.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Founder Identity Preparation (Phase 2 Bootstrap)
FOUNDER_EMAIL=
FOUNDER_FIREBASE_UID=

# ==============================================================================
# Future Phase Integration Placeholders
# ==============================================================================

# Dedicated database URLs for maintenance and the notification worker.
MIGRATION_DATABASE_URL=
MIGRATION_SHADOW_DATABASE_URL=
NOTIFICATION_DATABASE_URL=

# Notification worker. Capture processes local previews without SMTP.
EMAIL_DELIVERY_MODE=CAPTURE
EMAIL_SMTP_AUTHORIZED=false
EMAIL_ALLOWED_RECIPIENTS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=IntelliCore
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_SECONDS=60
EMAIL_RETRY_CAP_SECONDS=3600
NOTIFICATION_POLL_MS=5000
NOTIFICATION_BATCH_SIZE=5
NOTIFICATION_TASK_REMINDER_HOURS=24
NOTIFICATION_REPORT_REMINDER_MINUTES=30
NOTIFICATION_COMMENCEMENT_DAYS=2
NOTIFICATION_COMPLETION_DAYS=3

# Hostinger database examples for Vercel. Copy the selected values into Vercel's
# Sensitive Environment Variables without quotes. The active URL above is for Docker.
# Use the database hostname shown in Hostinger Remote MySQL and port 3306 (or
# your VPS database hostname and port). Allowlist the approved Vercel egress IPs.
# Use the full database/user names and URL-encode special characters in passwords.
# Hosted connections require TLS with valid server certificates.
# DATABASE_URL="mysql://HOSTINGER_APP_USER:URL_ENCODED_APP_PASSWORD@db.example.com:3306/HOSTINGER_DB_NAME?sslaccept=strict&connection_limit=2&connect_timeout=5&pool_timeout=5"
# Full IntelliCore requires a verified MySQL 8.4 server and separate runtime,
# migration and worker users. Hostinger Web/Cloud hPanel provides MariaDB and
# one user per database. A Hostinger VPS can run MySQL 8.4 with scoped users.
# On a compatible server, give the worker its own password and use the same host,
# port and database as DATABASE_URL. Keep migration credentials out of Vercel.
# NOTIFICATION_DATABASE_URL="mysql://intellicore_worker_hostinger:URL_ENCODED_WORKER_PASSWORD@db.example.com:3306/HOSTINGER_DB_NAME?sslaccept=strict&connection_limit=2&connect_timeout=5&pool_timeout=5"

# Vercel settings. Configure secrets in the target Vercel environment.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# BLOB_READ_WRITE_TOKEN=
# CRON_SECRET=
NOTIFICATION_CRON_ENABLED=false

# Optional Google Calendar and Meet integration. Provide secrets in the ignored .env only.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_EVENT_WRITES_AUTHORIZED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/v1/calendar/callback
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_ORGANIZER_UID=
GOOGLE_CALENDAR_TOKEN_KEY=
MEETING_REMINDER_MINUTES=1440,60,10

