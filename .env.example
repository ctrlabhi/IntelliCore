# ==============================================================================
# INTELLICORE V2.0 — MASTER ENVIRONMENT CONFIGURATION BLUEPRINT
# ==============================================================================
# Copy this file to .env for local development or reference when setting
# environment variables in Vercel.
# NEVER commit files containing actual secrets to version control.
# ==============================================================================

# ==============================================================================
# 1. APPLICATION SETTINGS
# ==============================================================================
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# ==============================================================================
# 2. HOSTINGER DATABASE CONNECTION (Prisma ORM)
# ==============================================================================
# Beginner-friendly individual variables (recommended for Hostinger):
DB_HOST=sql123.main-hosting.eu
DB_PORT=3306
DB_NAME=u123456789_intellicore
DB_USER=u123456789_app
DB_PASSWORD=your_hostinger_db_password
DB_SSL=true

# Or provide the full connection URL directly (overrides individual variables):
# DATABASE_URL=mysql://u123456789_app:your_password@sql123.main-hosting.eu:3306/u123456789_intellicore?sslaccept=strict&connection_limit=2&connect_timeout=5&pool_timeout=5

# ==============================================================================
# 3. DATABASE MIGRATION CREDENTIALS (DDL / Maintenance)
# ==============================================================================
# Dedicated migration connection with DDL privileges (CREATE, ALTER, DROP, INDEX).
# Used during deployment maintenance. Keep out of Vercel runtime functions.
MIGRATION_DATABASE_URL=mysql://u123456789_admin:migration_password@sql123.main-hosting.eu:3306/u123456789_intellicore?sslaccept=strict

# ==============================================================================
# 4. BACKGROUND WORKER DATABASE CREDENTIALS
# ==============================================================================
# Dedicated database account for background worker / cron execution.
# On hosting plans with multiple users, provide separate worker credentials.
# On single-user plans, this may point to the primary application database.
NOTIFICATION_DATABASE_URL=mysql://u123456789_worker:worker_password@sql123.main-hosting.eu:3306/u123456789_intellicore?sslaccept=strict

# ==============================================================================
# 5. FIREBASE CLIENT CONFIGURATION (Web Authentication SDK)
# ==============================================================================
# Public client SDK keys (safe for browser exposure).
# Development: intellicore-dev | Production: intellicore-229 (or your production project)
FIREBASE_PROJECT_ID=intellicore-dev
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=intellicore-dev.firebaseapp.com
FIREBASE_STORAGE_BUCKET=intellicore-dev.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# Primary Founder Identity (for first-time administrative bootstrap)
FOUNDER_EMAIL=ctrlabhishek@gmail.com
FOUNDER_FIREBASE_UID=your_firebase_auth_uid

# ==============================================================================
# 6. FIREBASE ADMIN CREDENTIALS (Server-Side Admin SDK)
# ==============================================================================
# For Vercel: Provide client email and private key (handles \n escaped newlines):
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@intellicore-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Or provide the complete raw JSON string in Vercel:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"intellicore-dev",...}

# Local development file fallback:
GOOGLE_APPLICATION_CREDENTIALS=secrets/firebase-admin-dev.json

# ==============================================================================
# 7. SMTP CONFIGURATION (Transactional Email Delivery)
# ==============================================================================
# Keep EMAIL_DELIVERY_MODE=CAPTURE until real SMTP provider is verified.
EMAIL_DELIVERY_MODE=CAPTURE
EMAIL_SMTP_AUTHORIZED=false
EMAIL_ALLOWED_RECIPIENTS=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
SMTP_USER=notifications@intellicoretechnologies.in
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM_NAME=IntelliCore Technologies
EMAIL_FROM_ADDRESS=notifications@intellicoretechnologies.in
EMAIL_REPLY_TO=support@intellicoretechnologies.in
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_SECONDS=60
EMAIL_RETRY_CAP_SECONDS=3600

# ==============================================================================
# 8. GOOGLE CALENDAR INTEGRATION (Optional)
# ==============================================================================
# Manual Google Meet links operate without credentials.
# OAuth credentials are only required if syncing Google Calendar events.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/v1/meetings/calendar/callback
GOOGLE_CALENDAR_ENCRYPTION_KEY=32_character_random_hex_key_here

# ==============================================================================
# 9. PERSISTENT STORAGE (Private Attachments & Artifacts)
# ==============================================================================
# Provider options: 'local' (Docker volume / filesystem) or 'vercel-blob' (cloud)
STORAGE_PROVIDER=local
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_SIZE_MB=25
TASK_MAX_FILE_SIZE_MB=5
TASK_MAX_ATTACHMENTS=5

# Vercel Blob Storage Token (Required if STORAGE_PROVIDER=vercel-blob):
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# ==============================================================================
# 10. SCHEDULED JOBS (Vercel Cron & Worker Configuration)
# ==============================================================================
# Secret token to authenticate Vercel Cron invocations against /api/internal/notification-tick
CRON_SECRET=minimum_32_character_random_hex_secret_here
NOTIFICATION_CRON_ENABLED=false
NOTIFICATION_POLL_MS=5000
NOTIFICATION_BATCH_SIZE=5
NOTIFICATION_TASK_REMINDER_HOURS=24
NOTIFICATION_REPORT_REMINDER_MINUTES=30
NOTIFICATION_COMMENCEMENT_DAYS=2
NOTIFICATION_COMPLETION_DAYS=3

# ==============================================================================
# 11. SECURITY SETTINGS
# ==============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000
