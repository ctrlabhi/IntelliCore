model Meeting {
  id                  String            @id @default(uuid()) @db.VarChar(36)
  meetingCode         String            @unique @map("meeting_code") @db.VarChar(50)
  organizerId         String            @map("organizer_id") @db.VarChar(36)
  departmentId        String?           @map("department_id") @db.VarChar(36)
  title               String            @db.VarChar(160)
  description         String            @db.Text
  audienceType        AnnouncementAudience @map("audience_type")
  selectedUserIds     Json              @map("selected_user_ids")
  creationMode        MeetingMode       @map("creation_mode")
  startAt             DateTime          @map("start_at")
  endAt               DateTime          @map("end_at")
  timezone            String            @default("Asia/Kolkata") @db.VarChar(40)
  meetingUrl          String?           @map("meeting_url") @db.VarChar(255)
  status              MeetingStatus     @default(DRAFT)
  version             Int               @default(0)
  providerSyncStatus  MeetingSyncStatus @default(NOT_REQUIRED) @map("provider_sync_status")
  providerEventId     String?           @unique @map("provider_event_id") @db.VarChar(64)
  conferenceRequestId String?           @unique @map("conference_request_id") @db.VarChar(64)
  calendarConnectionId String?          @map("calendar_connection_id") @db.VarChar(36)
  syncAttempts        Int               @default(0) @map("sync_attempts")
  syncAfter           DateTime?         @map("sync_after")
  syncLease           String?           @map("sync_lease") @db.VarChar(36)
  syncError           String?           @map("sync_error") @db.VarChar(80)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  cancelledAt         DateTime?         @map("cancelled_at")
  cancellationReason  String?           @map("cancellation_reason") @db.VarChar(500)

  organizer          User                @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  department         Department?         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  participants       MeetingParticipant[]
  calendarConnection CalendarConnection? @relation(fields: [calendarConnectionId], references: [id], onDelete: Restrict)

  @@index([status, startAt])
  @@index([departmentId, status])
  @@index([providerSyncStatus, syncAfter])
  @@map("meetings")
}

