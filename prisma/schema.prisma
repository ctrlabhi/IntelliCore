datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.VarChar(36)
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  category    String   @default("general") @db.VarChar(50)
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  INACTIVE
}

enum StaffEmploymentStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model User {
  id            String        @id @default(uuid()) @db.VarChar(36)
  firebaseUid   String        @unique @map("firebase_uid") @db.VarChar(128)
  email         String        @unique @db.VarChar(191)
  emailVerified Boolean       @default(false) @map("email_verified")
  status        AccountStatus @default(PENDING)
  lastLoginAt   DateTime?     @map("last_login_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  profile      Profile?
  staffProfile StaffProfile?
  userRoles    UserRole[]
  auditLogs    AuditLog[]     @relation("ActorAuditLogs")

  userDepartments        UserDepartment[]
  internshipApplications InternshipApplication[] @relation("ApplicantApplications")
  internships            Internship[]            @relation("InternEnrollments")
  assignedInternships    Internship[]            @relation("TeamLeaderInternships")
  requestedAttendanceCorrections AttendanceCorrection[] @relation("AttendanceCorrectionRequester")
  reviewedAttendanceCorrections  AttendanceCorrection[] @relation("AttendanceCorrectionReviewer")
  reviewedDailyWorkReports       DailyWorkReport[]
  reviewedLeaveRequests          LeaveRequest[]

  @@index([status])
  @@index([email])
  @@map("users")
}

model Profile {
  id              String   @id @default(uuid()) @db.VarChar(36)
  userId          String   @unique @map("user_id") @db.VarChar(36)
  fullName        String   @map("full_name") @db.VarChar(150)
  displayName     String?  @map("display_name") @db.VarChar(100)
  profilePhotoUrl String?  @map("profile_photo_url") @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Role {
  id           String   @id @default(uuid()) @db.VarChar(36)
  name         String   @db.VarChar(100)
  code         String   @unique @db.VarChar(50)
  description  String?  @db.VarChar(255)
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.VarChar(36)
  code        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.VarChar(36)
  roleId     String   @map("role_id") @db.VarChar(36)
  assignedBy String?  @map("assigned_by") @db.VarChar(36)
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.VarChar(36)
  permissionId String @map("permission_id") @db.VarChar(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model StaffProfile {
  id               String                @id @default(uuid()) @db.VarChar(36)
  userId           String                @unique @map("user_id") @db.VarChar(36)
  staffCode        String                @unique @map("staff_code") @db.VarChar(50)
  designation      String                @db.VarChar(100)
  joiningDate      DateTime              @map("joining_date")
  employmentStatus StaffEmploymentStatus @default(ACTIVE) @map("employment_status")
  createdBy        String?               @map("created_by") @db.VarChar(36)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employmentStatus])
  @@map("staff_profiles")
}

model AuditLog {
  id              String   @id @default(uuid()) @db.VarChar(36)
  actorUserId     String?  @map("actor_user_id") @db.VarChar(36)
  action          String   @db.VarChar(100)
  resourceType    String   @map("resource_type") @db.VarChar(50)
  resourceId      String?  @map("resource_id") @db.VarChar(36)
  sanitizedBefore String?  @map("sanitized_before") @db.Text
  sanitizedAfter  String?  @map("sanitized_after") @db.Text
  requestId       String?  @map("request_id") @db.VarChar(64)
  result          String   @default("SUCCESS") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at")

  actorUser User? @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
  @@map("audit_logs")
}

enum ApplicationStatus {
  DRAFT
  PENDING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum InternshipStatus {
  APPROVED
  ONGOING
  COMPLETION_REVIEW
  COMPLETED
  TERMINATED
  WITHDRAWN
}

model Department {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(50)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String?  @map("created_by") @db.VarChar(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userDepartments        UserDepartment[]
  internshipApplications InternshipApplication[]
  internships            Internship[]

  @@index([isActive])
  @@map("departments")
}

model UserDepartment {
  id           String   @id @default(uuid()) @db.VarChar(36)
  userId       String   @map("user_id") @db.VarChar(36)
  departmentId String   @map("department_id") @db.VarChar(36)
  assignedRole String   @default("STAFF") @map("assigned_role") @db.VarChar(50)
  assignedBy   String?  @map("assigned_by") @db.VarChar(36)
  assignedAt   DateTime @default(now()) @map("assigned_at")
  isActive     Boolean  @default(true) @map("is_active")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId, assignedRole])
  @@index([departmentId])
  @@index([userId])
  @@map("user_departments")
}

model InternshipApplication {
  id                 String            @id @default(uuid()) @db.VarChar(36)
  applicantUserId    String            @map("applicant_user_id") @db.VarChar(36)
  departmentId       String            @map("department_id") @db.VarChar(36)
  applicationStatus  ApplicationStatus @default(DRAFT) @map("application_status")
  requestedStartDate DateTime          @map("requested_start_date")
  requestedDuration  String            @map("requested_duration") @db.VarChar(50)
  qualification      String            @db.VarChar(150)
  institution        String            @db.VarChar(150)
  course             String?           @db.VarChar(150)
  specialization     String?           @db.VarChar(150)
  graduationYear     Int?              @map("graduation_year")
  skills             String?           @db.Text
  motivation         String?           @db.Text
  contactNumber      String?           @map("contact_number") @db.VarChar(20)
  submittedAt        DateTime?         @map("submitted_at")
  reviewedBy         String?           @map("reviewed_by") @db.VarChar(36)
  reviewedAt         DateTime?         @map("reviewed_at")
  reviewRemarks      String?           @map("review_remarks") @db.Text
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  applicantUser User        @relation("ApplicantApplications", fields: [applicantUserId], references: [id], onDelete: Cascade)
  department    Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  internship    Internship?

  @@index([applicantUserId])
  @@index([departmentId])
  @@index([applicationStatus])
  @@map("internship_applications")
}

model Internship {
  id                     String           @id @default(uuid()) @db.VarChar(36)
  internshipCode         String           @unique @map("internship_code") @db.VarChar(50)
  userId                 String           @map("user_id") @db.VarChar(36)
  applicationId          String           @unique @map("application_id") @db.VarChar(36)
  departmentId           String           @map("department_id") @db.VarChar(36)
  assignedTeamLeaderId   String?          @map("assigned_team_leader_id") @db.VarChar(36)
  positionTitle          String           @map("position_title") @db.VarChar(100)
  commencementDate       DateTime         @map("commencement_date")
  expectedCompletionDate DateTime         @map("expected_completion_date")
  actualCompletionDate   DateTime?        @map("actual_completion_date")
  duration               String?          @db.VarChar(50)
  workMode               String           @default("REMOTE") @map("work_mode") @db.VarChar(20)
  internshipStatus       InternshipStatus @default(APPROVED) @map("internship_status")
  approvedBy             String?          @map("approved_by") @db.VarChar(36)
  approvedAt             DateTime?        @map("approved_at")
  completionApprovedBy   String?          @map("completion_approved_by") @db.VarChar(36)
  completionApprovedAt   DateTime?        @map("completion_approved_at")
  terminationReason      String?          @map("termination_reason") @db.Text
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  user               User                  @relation("InternEnrollments", fields: [userId], references: [id], onDelete: Cascade)
  application        InternshipApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  department         Department            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assignedTeamLeader User?                 @relation("TeamLeaderInternships", fields: [assignedTeamLeaderId], references: [id], onDelete: SetNull)
  attendanceRecords  Attendance[]
  attendanceEligibility AttendanceEligibility[]
  dailyWorkReports   DailyWorkReport[]
  leaveRequests      LeaveRequest[]

  @@index([userId])
  @@index([departmentId])
  @@index([assignedTeamLeaderId])
  @@index([internshipStatus])
  @@map("internships")
}

enum AttendanceSource {
  DASHBOARD
  CORRECTION
}

enum DailyWorkReportStatus {
  DRAFT
  SUBMITTED
  REVIEWED
}

enum LeaveType {
  SICK_LEAVE
  CASUAL_LEAVE
  EMERGENCY_LEAVE
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceCorrectionKind {
  TIMESTAMPS
  LATE_REPORT
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendancePolicy {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  name                String   @db.VarChar(100)
  timezone            String   @default("Asia/Kolkata") @db.VarChar(64)
  workingDays         Json     @map("working_days")
  checkInTime         String   @default("09:30") @map("check_in_time") @db.Char(5)
  checkOutTime        String   @default("18:30") @map("check_out_time") @db.Char(5)
  reportDeadline      String   @default("20:00") @map("report_deadline") @db.Char(5)
  graceMinutes        Int      @default(0) @map("grace_minutes")
  requiresDailyReport Boolean  @default(true) @map("requires_daily_report")
  effectiveFrom       DateTime @unique @map("effective_from") @db.Date
  createdAt           DateTime @default(now()) @map("created_at")
  attendanceRecords   Attendance[]

  @@map("attendance_policies")
}

model AttendanceEligibility {
  id           String    @id @default(uuid()) @db.VarChar(36)
  internshipId String    @map("internship_id") @db.VarChar(36)
  startsAt     DateTime  @map("starts_at")
  endsAt       DateTime? @map("ends_at")
  firstDate    DateTime  @map("first_date") @db.Date
  lastDate     DateTime  @map("last_date") @db.Date
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Restrict)

  @@index([internshipId, endsAt])
  @@index([firstDate, lastDate])
  @@map("attendance_eligibility")
}

model Attendance {
  id            String           @id @default(uuid()) @db.VarChar(36)
  internshipId  String           @map("internship_id") @db.VarChar(36)
  businessDate  DateTime         @map("business_date") @db.Date
  policyId      String           @map("policy_id") @db.VarChar(36)
  checkInAt     DateTime?        @map("check_in_at")
  checkOutAt    DateTime?        @map("check_out_at")
  source        AttendanceSource @default(DASHBOARD)
  revision      Int              @default(0)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  internship    Internship       @relation(fields: [internshipId], references: [id], onDelete: Restrict)
  policy        AttendancePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  corrections   AttendanceCorrection[]

  @@unique([internshipId, businessDate])
  @@index([businessDate])
  @@map("attendance")
}

model DailyWorkReport {
  id                  String                @id @default(uuid()) @db.VarChar(36)
  internshipId        String                @map("internship_id") @db.VarChar(36)
  businessDate        DateTime              @map("business_date") @db.Date
  workCompleted       String                @map("work_completed") @db.Text
  learningSummary     String                @map("learning_summary") @db.Text
  progressSummary     String                @map("progress_summary") @db.Text
  blockers            String                @db.Text
  nextDayPlan         String                @map("next_day_plan") @db.Text
  status              DailyWorkReportStatus @default(DRAFT)
  submittedAt         DateTime?             @map("submitted_at")
  lateApprovedAt      DateTime?             @map("late_approved_at")
  reviewedBy          String?               @map("reviewed_by") @db.VarChar(36)
  reviewedAt          DateTime?             @map("reviewed_at")
  reviewRemarks       String?               @map("review_remarks") @db.Text
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  internship          Internship            @relation(fields: [internshipId], references: [id], onDelete: Restrict)
  reviewer            User?                 @relation(fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([internshipId, businessDate])
  @@index([businessDate, status])
  @@map("daily_work_reports")
}

model LeaveRequest {
  id                  String      @id @default(uuid()) @db.VarChar(36)
  internshipId        String      @map("internship_id") @db.VarChar(36)
  leaveType           LeaveType   @map("leave_type")
  startDate           DateTime    @map("start_date") @db.Date
  endDate             DateTime    @map("end_date") @db.Date
  workingDays         Int         @map("working_days")
  reason              String      @db.Text
  status              LeaveStatus @default(PENDING)
  reconciledActivity  Boolean     @default(false) @map("reconciled_activity")
  reviewedBy          String?     @map("reviewed_by") @db.VarChar(36)
  reviewedAt          DateTime?   @map("reviewed_at")
  reviewRemarks       String?     @map("review_remarks") @db.Text
  cancelledAt         DateTime?   @map("cancelled_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  internship          Internship  @relation(fields: [internshipId], references: [id], onDelete: Restrict)
  reviewer            User?       @relation(fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([internshipId, status, startDate, endDate])
  @@index([status, startDate])
  @@map("leave_requests")
}

model AttendanceCorrection {
  id                 String                     @id @default(uuid()) @db.VarChar(36)
  attendanceId       String                     @map("attendance_id") @db.VarChar(36)
  requestedBy        String                     @map("requested_by") @db.VarChar(36)
  kind               AttendanceCorrectionKind
  originalValues     Json                       @map("original_values")
  proposedChanges    Json                       @map("proposed_changes")
  reason             String                     @db.Text
  status             AttendanceCorrectionStatus @default(PENDING)
  reviewedBy         String?                    @map("reviewed_by") @db.VarChar(36)
  reviewedAt         DateTime?                  @map("reviewed_at")
  resolutionRemarks  String?                    @map("resolution_remarks") @db.Text
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  attendance         Attendance                 @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  requester          User                       @relation("AttendanceCorrectionRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  reviewer           User?                      @relation("AttendanceCorrectionReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([attendanceId, status])
  @@index([status, createdAt])
  @@map("attendance_corrections")
}
