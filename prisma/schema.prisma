enum EmailStatus {
  PENDING
  PROCESSING
  RETRY_SCHEDULED
  SENT
  FAILED
  CANCELLED
  CAPTURED
}

enum NotificationCategory {
  MEETING
  ACCOUNT
  INTERNSHIP
  ATTENDANCE
  LEAVE
  TASK
  LEARNING
  ANNOUNCEMENT
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  CANCELLED
  ARCHIVED
}

enum AnnouncementAudience {
  ALL_ACTIVE_USERS
  STAFF
  INTERNS
  DEPARTMENT
  SELECTED_USERS
}

model Notification {
  id                  String               @id @default(uuid()) @db.VarChar(36)
  recipientUserId     String               @map("recipient_user_id") @db.VarChar(36)
  eventType           String               @map("event_type") @db.VarChar(60)
  category            NotificationCategory
  title               String               @db.VarChar(160)
  message             String               @db.VarChar(600)
  relatedResourceType String               @map("related_resource_type") @db.VarChar(40)
  relatedResourceId   String               @map("related_resource_id") @db.VarChar(36)
  actionPath          String               @map("action_path") @db.VarChar(255)
  deduplicationKey    String               @unique @map("deduplication_key") @db.Char(64)
  onboarding          Boolean              @default(false)
  readAt              DateTime?            @map("read_at")
  archivedAt          DateTime?            @map("archived_at")
  createdAt           DateTime             @default(now()) @map("created_at")

  recipient    User          @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  email        EmailOutbox?
  announcement AnnouncementRecipient?

  @@index([recipientUserId, archivedAt, readAt, createdAt])
  @@index([recipientUserId, category, createdAt])
  @@index([eventType, relatedResourceId])
  @@map("notifications")
}

