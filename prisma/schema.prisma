  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("notification_preferences")
}

model EmailOutbox {
  id                 String      @id @default(uuid()) @db.VarChar(36)
  recipientUserId    String      @map("recipient_user_id") @db.VarChar(36)
  recipientEmail     String      @map("recipient_email") @db.VarChar(191)
  notificationId     String      @unique @map("notification_id") @db.VarChar(36)
  templateKey        String      @map("template_key") @db.VarChar(60)
  templateVersion    Int         @default(1) @map("template_version")
  templateData       Json        @map("template_data")
  authorization      Json
  deduplicationKey   String      @unique @map("deduplication_key") @db.Char(64)
  status             EmailStatus @default(PENDING)
  attemptCount       Int         @default(0) @map("attempt_count")
  maximumAttempts    Int         @default(5) @map("maximum_attempts")
  availableAt        DateTime    @default(now()) @map("available_at")
  nextAttemptAt      DateTime    @map("next_attempt_at")
  processingStartedAt DateTime?  @map("processing_started_at")
  leaseExpiresAt     DateTime?   @map("lease_expires_at")
  workerId           String?     @map("worker_id") @db.VarChar(36)
  sentAt             DateTime?   @map("sent_at")
  providerMessageId  String?     @map("provider_message_id") @db.VarChar(191)
  lastErrorCode      String?     @map("last_error_code") @db.VarChar(60)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  recipient    User                   @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  notification Notification           @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  attempts     EmailDeliveryAttempt[]

  @@index([status, nextAttemptAt, id])
  @@index([status, leaseExpiresAt])
  @@index([recipientUserId, createdAt])
  @@map("email_outbox")
}

model EmailDeliveryAttempt {
  id                String    @id @default(uuid()) @db.VarChar(36)
  emailOutboxId     String    @map("email_outbox_id") @db.VarChar(36)
  sequence           Int
  startedAt          DateTime  @map("started_at")
  finishedAt         DateTime? @map("finished_at")
  outcome            String    @db.VarChar(32)
  errorCode          String?   @map("error_code") @db.VarChar(60)
  providerMessageId String?   @map("provider_message_id") @db.VarChar(191)

  email EmailOutbox @relation(fields: [emailOutboxId], references: [id], onDelete: Restrict)

  @@unique([emailOutboxId, sequence])
  @@map("email_delivery_attempts")
}

