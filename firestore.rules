rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'password'];
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.get('role', '') in ['founder', 'co_founder', 'admin'];
    }

    function canViewInternProfiles() {
      return signedIn()
        && request.auth.token.get('role', '') in [
          'founder', 'co_founder', 'admin', 'hr_manager', 'hr_executive',
          'operations_executive'
        ];
    }

    function canMentorTrack(track) {
      return signedIn()
        && request.auth.token.get('role', '') == 'mentor'
        && track in request.auth.token.get('mentorTracks', []);
    }

    function learnerClaim() {
      return signedIn()
        && request.auth.token.get('role', 'learner') == 'learner';
    }

    match /profiles/{userId} {
      function isOwner() {
        return signedIn() && request.auth.uid == userId;
      }

      function validLearnerProfile() {
        let data = request.resource.data;
        return data.keys().hasAll([
            'uid', 'email', 'displayName', 'role', 'mentorTracks'
          ])
          && data.keys().hasOnly([
            'uid', 'email', 'displayName', 'role', 'mentorTracks',
            'track', 'gender', 'phone', 'durationMonths',
            'internshipStartDate', 'internshipEndDate', 'internshipStatus',
            'accountStatus', 'createdAt', 'updatedAt', 'lastLoginAt',
            'profileCompletedAt', 'roleAssignedBy', 'roleAssignedAt',
            'trackAssignedBy', 'trackAssignedAt', 'deactivatedAt',
            'deactivatedBy', 'reactivatedAt', 'reactivatedBy',
            'profileUpdatedBy'
          ])
          && data.uid == userId
          && data.email == request.auth.token.get('email', '')
          && data.displayName is string
          && data.displayName.size() <= 80
          && data.role == 'learner'
          && data.mentorTracks is list
          && data.mentorTracks.size() == 0
          && (!data.keys().hasAny(['track'])
            || data.track == null
            || data.track in [
              'Business Analyst Intern', 'Web Development Intern',
              'Data Analyst Intern', 'Digital Marketing Intern',
              'Graphic Designer Intern', 'Social Media Intern',
              'Content Writing Intern', 'Human Resources Intern'
            ])
          && (!data.keys().hasAny(['gender'])
            || data.gender == null
            || data.gender in ['Female', 'Male'])
          && (!data.keys().hasAny(['phone'])
            || data.phone == null
            || (data.phone is string
              && data.phone.size() >= 7
              && data.phone.size() <= 24
              && data.phone.matches('^[+()0-9 .-]+$')
              && data.phone.matches('^([^0-9]*[0-9]){7,15}[^0-9]*$')))
          && (!data.keys().hasAny(['durationMonths'])
            || data.durationMonths == null
            || (data.durationMonths is int && data.durationMonths in [1, 2, 3, 6]))
          && ((!data.keys().hasAny(['internshipStartDate'])
              && !data.keys().hasAny(['internshipEndDate']))
            || (data.internshipStartDate is string
              && data.internshipStartDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
              && data.internshipEndDate is string
              && data.internshipEndDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
              && data.internshipEndDate >= data.internshipStartDate
              && data.durationMonths is int
              && data.track is string
              && data.gender in ['Female', 'Male']
              && data.phone is string
              && data.internshipStatus == 'active'))
          && (!data.keys().hasAny(['accountStatus'])
            || data.accountStatus in ['active', 'deactivated']);
      }

      allow read: if signedIn() && (
        request.auth.uid == userId
        || canViewInternProfiles()
        || canMentorTrack(resource.data.track)
      );
      allow create: if isOwner()
        && learnerClaim()
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'mentorTracks', 'track'
        ])
        && (!request.resource.data.keys().hasAny(['track'])
          || request.resource.data.track == null)
        && validLearnerProfile();
      allow update: if isOwner()
        && learnerClaim()
        && resource.data.role == 'learner'
        && validLearnerProfile()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'gender', 'phone'
        ]);
    }

    match /users/{userId}/workspaceRecords/{recordId} {
      function isOwner() {
        return signedIn() && request.auth.uid == userId;
      }

      function hasValidRecord() {
        let data = request.resource.data;
        return data.keys().hasAll([
            'id', 'category', 'title', 'organisation', 'date',
            'status', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'id', 'category', 'title', 'organisation', 'date',
            'status', 'createdAt', 'updatedAt'
          ])
          && data.id == recordId
          && data.category in ['applications', 'tasks', 'certificates']
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 100
          && data.organisation is string
          && data.organisation.size() <= 120
          && data.date is string
          && data.date.size() <= 10
          && data.createdAt is int
          && data.updatedAt is int
          && (
            (data.category == 'applications'
              && data.status in [
                'Applied', 'Under review', 'Shortlisted',
                'Interview Scheduled', 'Selected', 'Rejected', 'Withdrawn'
              ])
            || (data.category == 'tasks'
              && data.status in ['To do', 'In progress', 'Completed'])
            || (data.category == 'certificates'
              && data.status in ['Earned', 'In progress'])
          );
      }

      allow read, delete: if isOwner();
      allow create: if isOwner() && hasValidRecord();
      allow update: if isOwner()
        && hasValidRecord()
        && request.resource.data.category == resource.data.category
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{userId}/profileDrafts/{draftId} {
      function isLearnerOwner() {
        let profilePath = /databases/$(database)/documents/profiles/$(userId);
        return signedIn()
          && request.auth.uid == userId
          && request.auth.token.get('role', 'learner') == 'learner'
          && (!exists(profilePath) || get(profilePath).data.role == 'learner');
      }

      function hasValidProfileDraft() {
        let data = request.resource.data;
        return data.keys().hasAll([
            'displayName', 'email', 'gender', 'phone', 'track',
            'durationMonths', 'internshipStartDate', 'internshipEndDate',
            'savedAt'
          ])
          && data.keys().hasOnly([
            'displayName', 'email', 'gender', 'phone', 'track',
            'durationMonths', 'internshipStartDate', 'internshipEndDate',
            'savedAt'
          ])
          && data.displayName is string
          && data.displayName.size() >= 2
          && data.displayName.size() <= 80
          && data.email is string
          && data.email == request.auth.token.get('email', '')
          && data.gender in ['Female', 'Male']
          && data.phone is string
          && data.phone.size() >= 7
          && data.phone.size() <= 24
          && data.phone.matches('^[+()0-9 .-]+$')
          && data.phone.matches('^([^0-9]*[0-9]){7,15}[^0-9]*$')
          && data.track in [
            'Business Analyst Intern', 'Web Development Intern',
            'Data Analyst Intern', 'Digital Marketing Intern',
            'Graphic Designer Intern', 'Social Media Intern',
            'Content Writing Intern', 'Human Resources Intern'
          ]
          && data.durationMonths is int
          && data.durationMonths in [1, 2, 3, 6]
          && data.internshipStartDate is string
          && data.internshipStartDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && data.internshipEndDate is string
          && data.internshipEndDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && data.internshipEndDate >= data.internshipStartDate
          && data.savedAt is timestamp
          && data.savedAt == request.time;
      }

      allow read: if draftId == 'current' && isLearnerOwner();
      allow create, update: if draftId == 'current'
        && isLearnerOwner()
        && hasValidProfileDraft();
    }

    match /trainingAssignments/{assignmentId} {
      function canReadAssignment() {
        return signedIn() && (
          resource.data.assignedToUid == request.auth.uid
          || isAdmin()
          || canMentorTrack(resource.data.track)
        );
      }

      allow read: if canReadAssignment();
      allow write: if false;

      match /submissions/{submissionId} {
        function canReadParentAssignment() {
          let assignment = get(
            /databases/$(database)/documents/trainingAssignments/$(assignmentId)
          ).data;
          return signedIn() && (
            assignment.assignedToUid == request.auth.uid
            || isAdmin()
            || canMentorTrack(assignment.track)
          );
        }

        allow read: if canReadParentAssignment();
        allow write: if false;
      }

      match /reviews/{reviewId} {
        function canReadParentAssignment() {
          let assignment = get(
            /databases/$(database)/documents/trainingAssignments/$(assignmentId)
          ).data;
          return signedIn() && (
            assignment.assignedToUid == request.auth.uid
            || isAdmin()
            || canMentorTrack(assignment.track)
          );
        }

        allow read: if canReadParentAssignment();
        allow write: if false;
      }
    }

    match /internships/{userId}/attendance/{attendanceId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
