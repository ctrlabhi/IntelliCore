rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'password'];
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.get('role', '') in ['founder', 'co_founder', 'admin'];
    }

    function canViewInternProfiles() {
      return signedIn()
        && request.auth.token.get('role', '') in [
          'founder', 'co_founder', 'admin', 'hr_manager', 'hr_executive',
          'operations_executive'
        ];
    }

    function canMentorTrack(track) {
      return signedIn()
        && request.auth.token.get('role', '') == 'mentor'
        && track in request.auth.token.get('mentorTracks', []);
    }

    match /profiles/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || canViewInternProfiles()
        || canMentorTrack(resource.data.track)
      );
      allow write: if false;
    }

    match /users/{userId}/workspaceRecords/{recordId} {
      function isOwner() {
        return signedIn() && request.auth.uid == userId;
      }

      function hasValidRecord() {
        let data = request.resource.data;
        return data.keys().hasAll([
            'id', 'category', 'title', 'organisation', 'date',
            'status', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'id', 'category', 'title', 'organisation', 'date',
            'status', 'createdAt', 'updatedAt'
          ])
          && data.id == recordId
          && data.category in ['applications', 'tasks', 'certificates']
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 100
          && data.organisation is string
          && data.organisation.size() <= 120
          && data.date is string
          && data.date.size() <= 10
          && data.createdAt is int
          && data.updatedAt is int
          && (
            (data.category == 'applications'
              && data.status in [
                'Applied', 'Under review', 'Shortlisted',
                'Interview Scheduled', 'Selected', 'Rejected', 'Withdrawn'
              ])
            || (data.category == 'tasks'
              && data.status in ['To do', 'In progress', 'Completed'])
            || (data.category == 'certificates'
              && data.status in ['Earned', 'In progress'])
          );
      }

      allow read, delete: if isOwner();
      allow create: if isOwner() && hasValidRecord();
      allow update: if isOwner()
        && hasValidRecord()
        && request.resource.data.category == resource.data.category
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{userId}/profileDrafts/{draftId} {
      function isLearnerOwner() {
        return signedIn()
          && request.auth.uid == userId
          && request.auth.token.get('role', 'learner') == 'learner'
          && exists(/databases/$(database)/documents/profiles/$(userId))
          && get(/databases/$(database)/documents/profiles/$(userId)).data.role == 'learner';
      }

      function hasValidProfileDraft() {
        let data = request.resource.data;
        return data.keys().hasAll([
            'displayName', 'email', 'gender', 'phone', 'track',
            'durationMonths', 'savedAt'
          ])
          && data.keys().hasOnly([
            'displayName', 'email', 'gender', 'phone', 'track',
            'durationMonths', 'savedAt'
          ])
          && data.displayName is string
          && data.displayName.size() >= 2
          && data.displayName.size() <= 80
          && data.email is string
          && data.email == request.auth.token.get('email', '')
          && data.gender in ['Female', 'Male']
          && data.phone is string
          && data.phone.size() >= 7
          && data.phone.size() <= 24
          && data.phone.matches('^[+()0-9 .-]+$')
          && data.phone.matches('^([^0-9]*[0-9]){7,15}[^0-9]*$')
          && data.track in [
            'Business Analyst Intern', 'Web Development Intern',
            'Data Analyst Intern', 'Digital Marketing Intern',
            'Graphic Designer Intern', 'Social Media Intern',
            'Content Writing Intern', 'Human Resources Intern'
          ]
          && data.durationMonths is int
          && data.durationMonths in [1, 2, 3, 6]
          && data.savedAt is timestamp
          && data.savedAt == request.time;
      }

      allow read: if draftId == 'current' && isLearnerOwner();
      allow create, update: if draftId == 'current'
        && isLearnerOwner()
        && hasValidProfileDraft();
    }

    match /trainingAssignments/{assignmentId} {
      function canReadAssignment() {
        return signedIn() && (
          resource.data.assignedToUid == request.auth.uid
          || isAdmin()
          || canMentorTrack(resource.data.track)
        );
      }

      allow read: if canReadAssignment();
      allow write: if false;

      match /submissions/{submissionId} {
        function canReadParentAssignment() {
          let assignment = get(
            /databases/$(database)/documents/trainingAssignments/$(assignmentId)
          ).data;
          return signedIn() && (
            assignment.assignedToUid == request.auth.uid
            || isAdmin()
            || canMentorTrack(assignment.track)
          );
        }

        allow read: if canReadParentAssignment();
        allow write: if false;
      }

      match /reviews/{reviewId} {
        function canReadParentAssignment() {
          let assignment = get(
            /databases/$(database)/documents/trainingAssignments/$(assignmentId)
          ).data;
          return signedIn() && (
            assignment.assignedToUid == request.auth.uid
            || isAdmin()
            || canMentorTrack(assignment.track)
          );
        }

        allow read: if canReadParentAssignment();
        allow write: if false;
      }
    }
  }
}
