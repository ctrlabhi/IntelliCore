# ==============================================================================
# INTELLICORE V2.0 — LOCAL DEVELOPMENT CONFIGURATION (.env.local.example)
# ==============================================================================
# Use this blueprint for local Docker Compose or standalone localhost development.
# Copy to .env.local or .env for local usage.
# ==============================================================================

# Application Settings
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=debug

# Local MySQL Database Configuration (Docker / Localhost)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=intellicore_db
DB_USER=intellicore_app
DB_PASSWORD=intellicore_dev_pass
DB_SSL=false

MYSQL_DATABASE=intellicore_db
MYSQL_USER=intellicore_app
MYSQL_PASSWORD=intellicore_dev_pass
MYSQL_ROOT_PASSWORD=intellicore_root_pass

# Internal Docker Compose connection URL:
# DATABASE_URL=mysql://intellicore_app:intellicore_dev_pass@mysql:3306/intellicore_db?connection_limit=10&connect_timeout=15

# Migration & Worker Local URLs
MIGRATION_DATABASE_URL=mysql://intellicore_migration:intellicore_migration_pass@127.0.0.1:3306/intellicore_db
NOTIFICATION_DATABASE_URL=mysql://intellicore_worker:intellicore_worker_pass@127.0.0.1:3306/intellicore_db

# Firebase Development Authentication (intellicore-dev)
FIREBASE_PROJECT_ID=intellicore-dev
GOOGLE_APPLICATION_CREDENTIALS=secrets/firebase-admin-dev.json
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=intellicore-dev.firebaseapp.com
FIREBASE_STORAGE_BUCKET=intellicore-dev.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

FOUNDER_EMAIL=founder@example.test
FOUNDER_FIREBASE_UID=intellicore-dev-founder-uid

# Local Storage (Persisted on Docker named volume / uploads folder)
STORAGE_PROVIDER=local
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_SIZE_MB=25
TASK_MAX_FILE_SIZE_MB=5
TASK_MAX_ATTACHMENTS=5

# Email in Capture Mode (No real emails sent during local development)
EMAIL_DELIVERY_MODE=CAPTURE
EMAIL_SMTP_AUTHORIZED=false

# Security & CORS
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000
